1 0 0 1 102.0 518.0 Tm
0.0000 Tw
(  38 ) Tj
1 0 0 1 102.0 506.0 Tm
0.0000 Tw
(  39 my $handle = DBI->connect\("DBI:mysql:$database:$host","$user","$password"\) ) Tj
1 0 0 1 102.0 494.0 Tm
0.0000 Tw
(  40         or die $DBI::errstr; ) Tj
1 0 0 1 102.0 482.0 Tm
0.0000 Tw
