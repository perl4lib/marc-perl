1 0 0 1 102.0 266.0 Tm
0.0000 Tw
(  59            print "Record for ISSN $ISSN added to database...\\n"; ) Tj
1 0 0 1 102.0 254.0 Tm
0.0000 Tw
(  60            $cursor->finish; ) Tj
1 0 0 1 102.0 242.0 Tm
0.0000 Tw
(  61         \} ) Tj
1 0 0 1 102.0 230.0 Tm
0.0000 Tw
(  62 \} ) Tj
