1 0 0 1 102.0 602.0 Tm
0.0000 Tw
(  31 # and submit the Z39.50 query. ) Tj
1 0 0 1 102.0 590.0 Tm
0.0000 Tw
(  32 my $mgr = Net::Z3950::Manager->new\( databaseName => 'voyager' \); ) Tj
1 0 0 1 102.0 578.0 Tm
0.0000 Tw
(  33 $mgr->option\( elementSetName => "f" \); ) Tj
1 0 0 1 102.0 566.0 Tm
0.0000 Tw
(  34 $mgr->option\( preferredRecordSyntax => Net::Z3950::RecordSyntax::USMARC \); ) Tj
1 0 0 1 102.0 554.0 Tm
0.0000 Tw
(  35 my $conn = $mgr->connect\('z3950.loc.gov', '7090'\); ) Tj
1 0 0 1 102.0 542.0 Tm
0.0000 Tw
(  36 croak "Unable to connect to server" if !defined\($conn\); ) Tj
1 0 0 1 102.0 530.0 Tm
0.0000 Tw
