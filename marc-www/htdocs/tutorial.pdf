1 0 0 1 102.0 425.6 Tm
0.0000 Tw
(  20     '245','1','4', ) Tj
1 0 0 1 102.0 413.6 Tm
0.0000 Tw
(  21       a => 'The alphabet effect /', ) Tj
1 0 0 1 102.0 401.6 Tm
0.0000 Tw
(  22       c => 'Robert K. Logan.' ) Tj
1 0 0 1 102.0 389.6 Tm
0.0000 Tw
(  23     \); ) Tj
1 0 0 1 102.0 377.6 Tm
0.0000 Tw
(  24   $record->append_fields\($title\); ) Tj
